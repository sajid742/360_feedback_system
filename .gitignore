# Dependencies and build output
node_modules/
dist/
.vite/
*.tsbuildinfo

# Generated Prisma clients
apps/mock-sis/generated/

# Local environment — NEVER commit these. Templates (*.example) are committed.
.env
.env.*
!.env.example
!.env.docker.example
apps/*/.env

# Issued licences. Not secret — the payload is signed, not encrypted — but they are
# per-customer deployment artifacts, and the installed licence lives in the database
# anyway (configurations, module='license'). A copy in the repo only goes stale.
# The signing keys live OUTSIDE this folder entirely and must never appear here.
*-license.txt
license-*.pem

# Logs, backups, OS noise
*.log
npm-debug.log*
backups/
.DS_Store
