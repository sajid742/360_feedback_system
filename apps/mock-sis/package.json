{
  "name": "mock-sis",
  "version": "0.1.0",
  "private": true,
  "description": "Mock Student Information System (SIS) — vendor-style REST APIs for integration testing of the 360 Feedback System.",
  "scripts": {
    "dev": "npx prisma@5.22.0 generate && npx nest start --watch",
    "build": "npx prisma@5.22.0 generate && npx nest build",
    "start": "node dist/main.js",
    "db:generate": "npx prisma@5.22.0 generate",
    "db:push": "npx prisma@5.22.0 db push",
    "db:seed": "npx prisma@5.22.0 generate && node ../api/scripts/run-ts.js prisma/seed.ts",
    "typecheck": "npx tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.9",
    "@nestjs/core": "^10.3.9",
    "@nestjs/platform-express": "^10.3.9",
    "@prisma/client": "^5.22.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
