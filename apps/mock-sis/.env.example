# Mock SIS — environment
# Its OWN database, separate from the 360 Feedback System's database.
MOCK_SIS_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mock_sis"

# Port the vendor API listens on.
PORT=3100

# Vendor API key. Callers (the 360 Feedback System) must send this as the
# `X-API-Key` header. Rotate freely — it simulates a real vendor credential.
SIS_API_KEY="mock-sis-dev-key-change-me"
