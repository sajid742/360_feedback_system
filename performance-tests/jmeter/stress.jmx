      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="A-HR-Admin" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">-1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">24</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(ramp,600)}</stringProp>
